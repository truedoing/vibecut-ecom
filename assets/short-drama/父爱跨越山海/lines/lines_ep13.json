  "lines": [
    {
      "t": 4.0,
      "text": "这里是红沙石场后院"
    },
    {
      "t": 6.0,
      "text": "门上两道铁链"
    },
    {
      "t": 7.0,
      "text": "一把大锁"
    },
    {
      "t": 10.0,
      "text": "屋里关着8个中国女人"
    },
    {
      "t": 15.0,
      "text": "我不怕了"
    },
    {
      "t": 16.0,
      "text": "我叫张丽"
    },
    {
      "t": 18.0,
      "text": "我被巴颂一家"
    },
    {
      "t": 19.0,
      "text": "关在这里一年"
    },
    {
      "t": 20.0,
      "text": "他们收了我护照"
    },
    {
      "t": 21.0,
      "text": "逼我给家里打电话要钱"
    },
    {
      "t": 23.0,
      "text": "不打"
    },
    {
      "t": 24.0,
      "text": "就不给饭"
    },
    {
      "t": 25.0,
      "text": "我也说"
    },
    {
      "t": 27.0,
      "text": "还有我"
    },
    {
      "t": 28.0,
      "text": "不急"
    },
    {
      "t": 30.0,
      "text": "等执法员来了"
    },
    {
      "t": 31.0,
      "text": "你们一个个说"
    },
    {
      "t": 32.0,
      "text": "大叔"
    },
    {
      "t": 33.0,
      "text": "执法员真会管吗"
    },
    {
      "t": 35.0,
      "text": "本地的不管"
    },
    {
      "t": 36.0,
      "text": "就找市里的"
    },
    {
      "t": 37.0,
      "text": "市里的不管"
    },
    {
      "t": 38.0,
      "text": "就找使馆"
    },
    {
      "t": 39.0,
      "text": "使馆不够就"
    },
    {
      "t": 40.0,
      "text": "让所有人看见"
    },
    {
      "t": 58.0,
      "text": "我越看越恶心"
    },
    {
      "t": 60.0,
      "text": "大叔"
    },
    {
      "t": 61.0,
      "text": "你们不是爱装体面吗"
    },
    {
      "t": 63.0,
      "text": "我今天就把这层皮"
    },
    {
      "t": 65.0,
      "text": "－寸－寸"
    },
    {
      "t": 67.0,
      "text": "给你们扒下来"
    }
  ]
}