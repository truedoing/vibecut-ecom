  "duration": 93.34,
  "step": 1.0,
  "frame_count": 93,
  "line_count": 60,
  "lines": [
    {
      "t": 2.0,
      "text": "腊月28"
    },
    {
      "t": 3.0,
      "text": "我远嫁东南亚的女儿"
    },
    {
      "t": 6.0,
      "text": "你还在工地啊"
    },
    {
      "t": 7.0,
      "text": "你今天怎么想起"
    },
    {
      "t": 8.0,
      "text": "给我打视频了"
    },
    {
      "t": 10.0,
      "text": "快过年了"
    },
    {
      "t": 11.0,
      "text": "想你了呗"
    },
    {
      "t": 13.0,
      "text": "她瘦了"
    },
    {
      "t": 14.0,
      "text": "最让我不舒服的"
    },
    {
      "t": 15.0,
      "text": "是她那个姿势"
    },
    {
      "t": 16.0,
      "text": "肩膀绷着"
    },
    {
      "t": 17.0,
      "text": "像旁边有人町着她一样"
    },
    {
      "t": 19.0,
      "text": "晓晓非说想您了"
    },
    {
      "t": 20.0,
      "text": "要给您视频"
    },
    {
      "t": 21.0,
      "text": "我说您肯定忙"
    },
    {
      "t": 24.0,
      "text": "如果是以前"
    },
    {
      "t": 25.0,
      "text": "我看见他这样"
    },
    {
      "t": 26.0,
      "text": "只会跟街坊说一句"
    },
    {
      "t": 27.0,
      "text": "我女婿孝顺"
    },
    {
      "t": 30.0,
      "text": "我只觉得他坐得太近了"
    },
    {
      "t": 31.0,
      "text": "近得像是在町着人"
    },
    {
      "t": 35.0,
      "text": "晓晓"
    },
    {
      "t": 36.0,
      "text": "你牙呢"
    },
    {
      "t": 37.0,
      "text": "她昨晚洗澡摔了一"
    },
    {
      "t": 39.0,
      "text": "我都说让她小心"
    },
    {
      "t": 41.0,
      "text": "她就是不听"
    },
    {
      "t": 42.0,
      "text": "摔的"
    },
    {
      "t": 44.0,
      "text": "我自己不小心"
    },
    {
      "t": 45.0,
      "text": "去医院了没"
    },
    {
      "t": 47.0,
      "text": "医生说问题不大"
    },
    {
      "t": 49.0,
      "text": "就是吃不了硬的"
    },
    {
      "t": 50.0,
      "text": "那就好"
    },
    {
      "t": 52.0,
      "text": "这不是他们家"
    },
    {
      "t": 54.0,
      "text": "我去过他们家"
    },
    {
      "t": 55.0,
      "text": "海边一栋小白楼"
    },
    {
      "t": 56.0,
      "text": "客厅有落地窗"
    },
    {
      "t": 57.0,
      "text": "窗外能看见椰子树"
    },
    {
      "t": 60.0,
      "text": "你这是在哪"
    },
    {
      "t": 61.0,
      "text": "仓库呀"
    },
    {
      "t": 62.0,
      "text": "今天货多"
    },
    {
      "t": 63.0,
      "text": "我帮他理理"
    },
    {
      "t": 64.0,
      "text": "外面风大"
    },
    {
      "t": 65.0,
      "text": "她牙疼"
    },
    {
      "t": 66.0,
      "text": "我怕他着凉"
    },
    {
      "t": 67.0,
      "text": "就把窗户关了"
    },
    {
      "t": 69.0,
      "text": "打的是晓晓"
    },
    {
      "t": 70.0,
      "text": "你最近朋友圈发的挺勤啊"
    },
    {
      "t": 72.0,
      "text": "那张蛋糕照挺好看"
    },
    {
      "t": 73.0,
      "text": "谁买的"
    },
    {
      "t": 75.0,
      "text": "就这一个字"
    },
    {
      "t": 76.0,
      "text": "我心里彻底凉了"
    },
    {
      "t": 77.0,
      "text": "如果朋友圈是她自己发的"
    },
    {
      "t": 79.0,
      "text": "我在说什么"
    },
    {
      "t": 81.0,
      "text": "除非朋友圈不是她发的"
    },
    {
      "t": 82.0,
      "text": "我买的爸"
    },
    {
      "t": 83.0,
      "text": "她前两天还说"
    },
    {
      "t": 84.0,
      "text": "您要是在就好了"
    },
    {
      "t": 87.0,
      "text": "我已经看明白了"
    },
    {
      "t": 88.0,
      "text": "我得先把晓晓弄出来"
    },
    {
      "t": 91.0,
      "text": "工人等着结账"
    }
  ]
}