  "lines": [
    {
      "t": 1.0,
      "text": "砸得好"
    },
    {
      "t": 3.0,
      "text": "大叔"
    },
    {
      "t": 5.0,
      "text": "你知道晓晓"
    },
    {
      "t": 6.0,
      "text": "为啥打最多吗"
    },
    {
      "t": 8.0,
      "text": "因为她不肯"
    },
    {
      "t": 9.0,
      "text": "再给你打电话要钱"
    },
    {
      "t": 11.0,
      "text": "他们逼他说"
    },
    {
      "t": 13.0,
      "text": "我要钱"
    },
    {
      "t": 14.0,
      "text": "他不说"
    },
    {
      "t": 15.0,
      "text": "巴松就打她"
    },
    {
      "t": 18.0,
      "text": "那颗牙就是5天前打掉的"
    },
    {
      "t": 22.0,
      "text": "晓晓确实给我打过电话"
    },
    {
      "t": 24.0,
      "text": "她说生意周转"
    },
    {
      "t": 25.0,
      "text": "想借20万"
    },
    {
      "t": 26.0,
      "text": "我当时还骂她"
    },
    {
      "t": 28.0,
      "text": "你们年轻人花钱没数"
    },
    {
      "t": 29.0,
      "text": "别什么都找家里"
    },
    {
      "t": 32.0,
      "text": "后来我还是转了"
    },
    {
      "t": 34.0,
      "text": "可我不知道"
    },
    {
      "t": 35.0,
      "text": "那通电话"
    },
    {
      "t": 36.0,
      "text": "是她被人逼着打的"
    },
    {
      "t": 38.0,
      "text": "我这双手"
    },
    {
      "t": 39.0,
      "text": "给别人盖过楼"
    },
    {
      "t": 41.0,
      "text": "搭过桥"
    },
    {
      "t": 43.0,
      "text": "却差点没护住自己的闺女"
    },
    {
      "t": 47.0,
      "text": "大叔"
    },
    {
      "t": 48.0,
      "text": "他一直说他爸挣钱不容易"
    },
    {
      "t": 51.0,
      "text": "他不能再害你"
    },
    {
      "t": 53.0,
      "text": "不是他害我"
    },
    {
      "t": 55.0,
      "text": "是那家畜生害他"
    },
    {
      "t": 64.0,
      "text": "他们回来了"
    },
    {
      "t": 67.0,
      "text": "回来正好"
    },
    {
      "t": 69.0,
      "text": "从现在开始算账"
    }
  ]
}