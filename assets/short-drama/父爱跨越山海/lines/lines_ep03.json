  "lines": [
    {
      "t": 5.0,
      "text": "她现在连点一下屏幕"
    },
    {
      "t": 6.0,
      "text": "的自由都不一定有"
    },
    {
      "t": 8.0,
      "text": "要不要报案"
    },
    {
      "t": 9.0,
      "text": "要不要先打使馆电话"
    },
    {
      "t": 11.0,
      "text": "报什么"
    },
    {
      "t": 13.0,
      "text": "她在哪都不知道"
    },
    {
      "t": 14.0,
      "text": "隔着半个地球"
    },
    {
      "t": 16.0,
      "text": "执法员去了"
    },
    {
      "t": 17.0,
      "text": "人家一句两口子吵架"
    },
    {
      "t": 19.0,
      "text": "就圆过去了"
    },
    {
      "t": 20.0,
      "text": "那咱就这么去"
    },
    {
      "t": 21.0,
      "text": "先找到人"
    },
    {
      "t": 23.0,
      "text": "只要我见到他"
    },
    {
      "t": 24.0,
      "text": "剩下的账"
    },
    {
      "t": 26.0,
      "text": "一笔一笔算"
    },
    {
      "t": 30.0,
      "text": "到了那边"
    },
    {
      "t": 31.0,
      "text": "不准乱来"
    },
    {
      "t": 32.0,
      "text": "爸那是我姐"
    },
    {
      "t": 33.0,
      "text": "我知道"
    },
    {
      "t": 37.0,
      "text": "所以更不能乱来"
    },
    {
      "t": 41.0,
      "text": "老板去哪"
    },
    {
      "t": 42.0,
      "text": "我叫阿南"
    },
    {
      "t": 43.0,
      "text": "在广州打过工"
    },
    {
      "t": 45.0,
      "text": "找我女儿"
    },
    {
      "t": 46.0,
      "text": "海边小白楼"
    },
    {
      "t": 47.0,
      "text": "可以"
    },
    {
      "t": 51.0,
      "text": "到地方时"
    },
    {
      "t": 52.0,
      "text": "我心已经沉到底"
    },
    {
      "t": 58.0,
      "text": "陈叔"
    },
    {
      "t": 59.0,
      "text": "他说这对小两口"
    },
    {
      "t": 61.0,
      "text": "半年前就搬走了"
    },
    {
      "t": 62.0,
      "text": "欠了半年房租"
    },
    {
      "t": 63.0,
      "text": "房东赶走的"
    },
    {
      "t": 64.0,
      "text": "半年"
    },
    {
      "t": 66.0,
      "text": "我姐上礼拜"
    },
    {
      "t": 67.0,
      "text": "还说她在家里给巴颂做饭"
    },
    {
      "t": 69.0,
      "text": "他说他在家"
    },
    {
      "t": 71.0,
      "text": "可家是空的"
    },
    {
      "t": 73.0,
      "text": "那这半年"
    },
    {
      "t": 74.0,
      "text": "他在哪"
    },
    {
      "t": 77.0,
      "text": "附近有没有以前"
    },
    {
      "t": 78.0,
      "text": "给他们家干活的人"
    },
    {
      "t": 79.0,
      "text": "有个叫彭的"
    },
    {
      "t": 80.0,
      "text": "以前给他们做饭"
    },
    {
      "t": 82.0,
      "text": "现在老市场卖菜"
    },
    {
      "t": 84.0,
      "text": "去老市场"
    }
  ]
}