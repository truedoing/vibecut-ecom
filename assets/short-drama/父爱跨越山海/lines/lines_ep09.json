  "step": 1.0,
  "frame_count": 71,
  "line_count": 34,
  "lines": [
    {
      "t": 1.0,
      "text": "大叔我叫小芸"
    },
    {
      "t": 3.0,
      "text": "他们说我家里不打钱"
    },
    {
      "t": 5.0,
      "text": "就把我卖到山里去"
    },
    {
      "t": 7.0,
      "text": "我妈已经把房子抵押了"
    },
    {
      "t": 10.0,
      "text": "屋里一共8个中国女人"
    },
    {
      "t": 12.0,
      "text": "有的坐不直"
    },
    {
      "t": 13.0,
      "text": "有的脚上也有锁"
    },
    {
      "t": 15.0,
      "text": "有的看着我们"
    },
    {
      "t": 16.0,
      "text": "连哭都不敢出声"
    },
    {
      "t": 19.0,
      "text": "这么多人"
    },
    {
      "t": 21.0,
      "text": "你先走"
    },
    {
      "t": 22.0,
      "text": "你带弟弟走"
    },
    {
      "t": 24.0,
      "text": "我没事的"
    },
    {
      "t": 25.0,
      "text": "闭嘴"
    },
    {
      "t": 27.0,
      "text": "一个都不留"
    },
    {
      "t": 29.0,
      "text": "我全带走"
    },
    {
      "t": 30.0,
      "text": "先开我女儿脚上的锁"
    },
    {
      "t": 32.0,
      "text": "再开其他人的"
    },
    {
      "t": 38.0,
      "text": "我背你"
    },
    {
      "t": 40.0,
      "text": "不能报案"
    },
    {
      "t": 42.0,
      "text": "为什么"
    },
    {
      "t": 43.0,
      "text": "巴颂说"
    },
    {
      "t": 45.0,
      "text": "只要我敢说出去"
    },
    {
      "t": 48.0,
      "text": "就让我弟在国内小心点"
    },
    {
      "t": 50.0,
      "text": "我先砸死他"
    },
    {
      "t": 52.0,
      "text": "你给我站住"
    },
    {
      "t": 55.0,
      "text": "他们把姐锁成这样"
    },
    {
      "t": 57.0,
      "text": "我还忍什么"
    },
    {
      "t": 58.0,
      "text": "你现在冲进去杀人"
    },
    {
      "t": 59.0,
      "text": "你姐怎么办"
    },
    {
      "t": 62.0,
      "text": "国外背一辈子案底"
    },
    {
      "t": 64.0,
      "text": "你想让他们反咬咱们"
    },
    {
      "t": 66.0,
      "text": "说咱们闯私宅杀人"
    },
    {
      "t": 68.0,
      "text": "你脑子给我清醒点"
    }
  ]
}