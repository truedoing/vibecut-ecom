    {
      "t": 3.0,
      "text": "去哪回城里"
    },
    {
      "t": 6.0,
      "text": "不回"
    },
    {
      "t": 7.0,
      "text": "去镇上"
    },
    {
      "t": 10.0,
      "text": "买东西"
    },
    {
