  "lines": [
    {
      "t": 3.0,
      "text": "你怎么突然打电话呀"
    },
    {
      "t": 4.0,
      "text": "我正炒菜呢"
    },
    {
      "t": 7.0,
      "text": "红烧肉"
    },
    {
      "t": 9.0,
      "text": "你以后来找我"
    },
    {
      "t": 10.0,
      "text": "我做给你吃"
    },
    {
      "t": 12.0,
      "text": "那你手艺见长了"
    },
    {
      "t": 14.0,
      "text": "还行"
    },
    {
      "t": 15.0,
      "text": "你别担心我"
    },
    {
      "t": 16.0,
      "text": "我最近挺好的"
    },
    {
      "t": 18.0,
      "text": "你过年别折腾了"
    },
    {
      "t": 19.0,
      "text": "就在家好好歇着"
    },
    {
      "t": 21.0,
      "text": "你婆婆呢"
    },
    {
      "t": 22.0,
      "text": "去市场卖布了"
    },
    {
      "t": 23.0,
      "text": "那正好"
    },
    {
      "t": 24.0,
      "text": "让巴颂给你多切点水果"
    },
    {
      "t": 26.0,
      "text": "你牙掉了"
    },
    {
      "t": 27.0,
      "text": "别吃硬的"
    },
    {
      "t": 29.0,
      "text": "还等什么进去啊"
    },
    {
      "t": 33.0,
      "text": "你好"
    },
    {
      "t": 34.0,
      "text": "我叫陈铁山"
    },
    {
      "t": 35.0,
      "text": "中国人"
    },
    {
      "t": 36.0,
      "text": "我女儿陈晓"
    },
    {
      "t": 37.0,
      "text": "嫁给当地人巴颂"
    },
    {
      "t": 39.0,
      "text": "被关在城郊红土石场"
    },
    {
      "t": 41.0,
      "text": "我亲耳听见她在里面挨打"
    },
    {
      "t": 44.0,
      "text": "我今天要进去接人"
    },
    {
      "t": 46.0,
      "text": "您不要自己冲"
    },
    {
      "t": 47.0,
      "text": "请您把地址告诉我"
    },
    {
      "t": 49.0,
      "text": "我马上联系当地执法方"
    },
    {
      "t": 50.0,
      "text": "就在城西的废弃石场"
    },
    {
      "t": 54.0,
      "text": "两个小时内我没消息"
    },
    {
      "t": 56.0,
      "text": "你就当我也被关了"
    },
    {
      "t": 57.0,
      "text": "陈先生"
    },
    {
      "t": 58.0,
      "text": "您千万别"
    },
    {
      "t": 60.0,
      "text": "你这是给自己留后路"
    },
    {
      "t": 63.0,
      "text": "是给你姐留"
    },
    {
      "t": 64.0,
      "text": "万一咱们进去了出不来"
    },
    {
      "t": 67.0,
      "text": "至少有人知道"
    },
    {
      "t": 68.0,
      "text": "她在哪"
    }
  ]
}