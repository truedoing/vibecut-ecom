  "lines": [
    {
      "t": 0.0,
      "text": "你跟村民说"
    },
    {
      "t": 1.0,
      "text": "让他们进去看铁皮屋"
    },
    {
      "t": 3.0,
      "text": "这是村长"
    },
    {
      "t": 15.0,
      "text": "村长问他"
    },
    {
      "t": 16.0,
      "text": "这就是你说的仓库"
    },
    {
      "t": 18.0,
      "text": "误会"
    },
    {
      "t": 19.0,
      "text": "都是误会"
    },
    {
      "t": 20.0,
      "text": "他们是来打工的"
    },
    {
      "t": 22.0,
      "text": "有合同"
    },
    {
      "t": 23.0,
      "text": "自愿打工要扣护照吗"
    },
    {
      "t": 25.0,
      "text": "自愿打工要锁脚吗"
    },
    {
      "t": 27.0,
      "text": "好样的"
    },
    {
      "t": 30.0,
      "text": "执法员"
    },
    {
      "t": 31.0,
      "text": "你不进铁皮屋"
    },
    {
      "t": 33.0,
      "text": "不调查先抓我"
    },
    {
      "t": 34.0,
      "text": "爸差不多行了"
    },
    {
      "t": 36.0,
      "text": "你女儿已经被你带走了"
    },
    {
      "t": 38.0,
      "text": "你还想怎么样"
    },
    {
      "t": 39.0,
      "text": "我想算账"
    },
    {
      "t": 40.0,
      "text": "你娶我女儿"
    },
    {
      "t": 41.0,
      "text": "一分钱彩礼没出"
    },
    {
      "t": 43.0,
      "text": "婚宴"
    },
    {
      "t": 44.0,
      "text": "是我花的钱"
    },
    {
      "t": 45.0,
      "text": "她带来的嫁妆"
    },
    {
      "t": 46.0,
      "text": "你们收了"
    },
    {
      "t": 47.0,
      "text": "半年前"
    },
    {
      "t": 48.0,
      "text": "你说生意周转"
    },
    {
      "t": 49.0,
      "text": "我转了20万"
    },
    {
      "t": 52.0,
      "text": "是不是拿20万买的"
    }
  ]
}