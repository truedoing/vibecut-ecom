  "lines": [
    {
      "t": 0.0,
      "text": "大姐"
    },
    {
      "t": 1.0,
      "text": "这位是陈晓的父亲"
    },
    {
      "t": 2.0,
      "text": "他特意过来的"
    },
    {
      "t": 3.0,
      "text": "关于巴颂的事"
    },
    {
      "t": 7.0,
      "text": "他过得很好"
    },
    {
      "t": 9.0,
      "text": "你怎么才来啊"
    },
    {
      "t": 10.0,
      "text": "陈叔"
    },
    {
      "t": 11.0,
      "text": "你女儿命真硬"
    },
    {
      "t": 13.0,
      "text": "去年从楼梯上滚下来"
    },
    {
      "t": 14.0,
      "text": "腿差点废了"
    },
    {
      "t": 18.0,
      "text": "你不知道"
    },
    {
      "t": 20.0,
      "text": "她现在在哪"
    },
    {
      "t": 21.0,
      "text": "城郊红土石场"
    },
    {
      "t": 23.0,
      "text": "巴颂做生意赔光了"
    },
    {
      "t": 25.0,
      "text": "小白楼住不起"
    },
    {
      "t": 27.0,
      "text": "全家搬到那边了"
    },
    {
      "t": 28.0,
      "text": "后院有间铁皮屋"
    },
    {
      "t": 30.0,
      "text": "门上挂锁"
    },
    {
      "t": 31.0,
      "text": "里面老有女人哭"
    },
    {
      "t": 33.0,
      "text": "说中国话"
    },
    {
      "t": 34.0,
      "text": "不止一个"
    },
    {
      "t": 35.0,
      "text": "有一次我送菜"
    },
    {
      "t": 37.0,
      "text": "看见你女儿腿拖着走"
    },
    {
      "t": 39.0,
      "text": "娜帕还骂她"
    },
    {
      "t": 40.0,
      "text": "说她装死"
    },
    {
      "t": 44.0,
      "text": "城南执法局沙昆执法长官"
    },
    {
      "t": 46.0,
      "text": "是巴颂的酒友"
    },
    {
      "t": 48.0,
      "text": "上次有村民多嘴"
    },
    {
      "t": 50.0,
      "text": "第二天被奥玛拉推走了"
    },
    {
      "t": 58.0,
      "text": "爸进去吗"
    },
    {
      "t": 60.0,
      "text": "先看"
    },
    {
      "t": 63.0,
      "text": "你爸不给钱"
    },
    {
      "t": 64.0,
      "text": "你就别吃饭"
    },
    {
      "t": 66.0,
      "text": "我错了"
    },
    {
      "t": 67.0,
      "text": "别打了"
    },
    {
      "t": 69.0,
      "text": "站住"
    },
    {
      "t": 71.0,
      "text": "爸那是我姐"
    },
    {
      "t": 74.0,
      "text": "你现在冲进去"
    },
    {
      "t": 76.0,
      "text": "她还在他们手里"
    },
    {
      "t": 77.0,
      "text": "你是想把她逼死吗"
    },
    {
      "t": 80.0,
      "text": "这时候打电话"
    },
    {
      "t": 81.0,
      "text": "他们会不会"
    },
    {
      "t": 83.0,
      "text": "不会"
    },
    {
      "t": 84.0,
      "text": "他们要她活着跟我要钱"
    },
    {
      "t": 86.0,
      "text": "我这个电话打过去"
    },
    {
      "t": 88.0,
      "text": "他们只会停手"
    },
    {
      "t": 93.0,
      "text": "铃声在里面"
    },
    {
      "t": 94.0,
      "text": "你敢不接试试"
    }
  ]
}