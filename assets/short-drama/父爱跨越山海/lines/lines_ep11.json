  "lines": [
    {
      "t": 1.0,
      "text": "这次也一样"
    },
    {
      "t": 3.0,
      "text": "你先去医院"
    },
    {
      "t": 4.0,
      "text": "爸随后就到"
    },
    {
      "t": 7.0,
      "text": "你骗我"
    },
    {
      "t": 9.0,
      "text": "爸什么时候骗过你"
    },
    {
      "t": 11.0,
      "text": "你骗她不少的"
    },
    {
      "t": 12.0,
      "text": "闭嘴"
    },
    {
      "t": 13.0,
      "text": "大叔你别出事"
    },
    {
      "t": 15.0,
      "text": "你到了医院"
    },
    {
      "t": 16.0,
      "text": "先给你妈打电话"
    },
    {
      "t": 18.0,
      "text": "我妈肯定吓坏了"
    },
    {
      "t": 20.0,
      "text": "那就告诉她"
    },
    {
      "t": 21.0,
      "text": "你活着"
    },
    {
      "t": 23.0,
      "text": "陈叔"
    },
    {
      "t": 24.0,
      "text": "我送完他们就回来"
    },
    {
      "t": 25.0,
      "text": "路上别停"
    },
    {
      "t": 35.0,
      "text": "我看懂了"
    },
    {
      "t": 36.0,
      "text": "他喊的是"
    },
    {
      "t": 39.0,
      "text": "你们也得走"
    },
    {
      "t": 40.0,
      "text": "阿迪去叫车了"
    },
    {
      "t": 42.0,
      "text": "我不走"
    },
    {
      "t": 43.0,
      "text": "你别遥强"
    },
    {
      "t": 45.0,
      "text": "我在这关了一年"
    },
    {
      "t": 47.0,
      "text": "每天听他们脚步声"
    },
    {
      "t": 49.0,
      "text": "都怕他们开门"
    },
    {
      "t": 51.0,
      "text": "今天门开了"
    },
    {
      "t": 53.0,
      "text": "我要亲眼看见"
    },
    {
      "t": 55.0,
      "text": "他们完蛋"
    },
    {
      "t": 56.0,
      "text": "我也不走"
    },
    {
      "t": 57.0,
      "text": "我能撑"
    },
    {
      "t": 59.0,
      "text": "你们确定"
    },
    {
      "t": 62.0,
      "text": "他们4点左右回来"
    },
    {
      "t": 63.0,
      "text": "你们要留下"
    },
    {
      "t": 64.0,
      "text": "就听我安排"
    },
    {
      "t": 66.0,
      "text": "你说"
    },
    {
      "t": 68.0,
      "text": "先别回里面"
    },
    {
      "t": 69.0,
      "text": "都到主屋客厅去"
    },
    {
      "t": 71.0,
      "text": "屋里有沙发"
    },
    {
      "t": 73.0,
      "text": "别乱跑"
    },
    {
      "t": 75.0,
      "text": "他们回来要是打我们呢"
    }
  ]
