    {
      "t": 0.0,
      "text": "我在广州最难的时候"
    },
    {
      "t": 2.0,
      "text": "是一个中国老板娘收留我"
    },
    {
      "t": 4.0,
      "text": "给我饭吃"
    },
    {
      "t": 5.0,
      "text": "今天我帮你"
    },
    {
      "t": 7.0,
      "text": "兄弟"
    },
    {
      "t": 8.0,
      "text": "这份情"
    },
    {
      "t": 10.0,
      "text": "先等"
    },
    {
      "t": 14.0,
      "text": "这车多少钱"
    },
    {
      "t": 16.0,
      "text": "我半年前打给晓晓"
    },
    {
      "t": 18.0,
      "text": "那20万"
    },
    {
      "t": 19.0,
      "text": "够买它了吧"
    },
    {
      "t": 25.0,
      "text": "那是巴颂弟弟奥玛拉"
    },
    {
      "t": 27.0,
      "text": "爸现在没人了"
    },
    {
      "t": 33.0,
      "text": "这是你家"
    },
    {
      "t": 34.0,
      "text": "我女儿家"
    },
    {
      "t": 35.0,
      "text": "她电话打不通"
    },
    {
      "t": 36.0,
      "text": "我来看看"
    },
    {
      "t": 42.0,
      "text": "怎么这么臭"
    },
    {
      "t": 48.0,
      "text": "晓晓"
    },
    {
      "t": 51.0,
      "text": "晓晓爸来了"
    },
    {
      "t": 58.0,
      "text": "去后面"
    }
  ]
