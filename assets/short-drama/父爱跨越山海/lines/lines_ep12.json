      "text": "有时候没有"
    },
    {
      "t": 29.0,
      "text": "水呢"
    },
    {
      "t": 32.0,
      "text": "几个人分"
    },
    {
      "t": 33.0,
      "text": "不听话就不给水"
    },
    {
      "t": 35.0,
      "text": "是不是他们回来了"
    },
    {
      "t": 40.0,
      "text": "陈先生"
    },
    {
      "t": 41.0,
      "text": "您现在在哪"
    },
    {
      "t": 42.0,
      "text": "人找到了"
    },
    {
