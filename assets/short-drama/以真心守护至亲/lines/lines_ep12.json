  "lines": [
    {
      "t": 0.0,
      "text": "合同我签的"
    },
    {
      "t": 2.0,
      "text": "你不嫁了还想带"
    },
    {
      "t": 3.0,
      "text": "个人来占着婚房"
    },
    {
      "t": 4.0,
      "text": "房子是谁付的钱"
    },
    {
      "t": 6.0,
      "text": "他的东西你们问过就往外扔"
    },
    {
      "t": 8.0,
      "text": "你少管姐姐领你走的"
    },
    {
      "t": 9.0,
      "text": "时候不是挺硬气"
    },
    {
      "t": 11.0,
      "text": "现在没地方住"
    },
    {
      "t": 12.0,
      "text": "倒想起周家的好了"
    },
    {
      "t": 13.0,
      "text": "房租从头到尾都是我付的"
    },
    {
      "t": 17.0,
      "text": "这不是周家的房子"
    },
    {
      "t": 19.0,
      "text": "更不是你抢了婚"
    },
    {
      "t": 20.0,
      "text": "就能接着抢的东西"
    },
    {
      "t": 21.0,
      "text": "放下别碰他的资料"
    },
    {
      "t": 26.0,
      "text": "拿过几个奖了不起"
    },
    {
      "t": 28.0,
      "text": "今天在婚礼上"
    },
    {
      "t": 29.0,
      "text": "你不是连工作都不要"
    },
    {
      "t": 31.0,
      "text": "靠这几张纸养得活你妈"
    },
    {
      "t": 33.0,
      "text": "我怎么生活用不着你操心"
    },
    {
      "t": 36.0,
      "text": "东西搬回去"
    },
    {
      "t": 38.0,
      "text": "这双鞋你什么时候放进来的"
    },
    {
      "t": 42.0,
      "text": "关你什么事"
    },
    {
      "t": 43.0,
      "text": "拿着东西走"
    },
    {
      "t": 45.0,
      "text": "我不在家的时候"
    },
    {
      "t": 47.0,
      "text": "你到底来过多少次"
    }
  ]
}