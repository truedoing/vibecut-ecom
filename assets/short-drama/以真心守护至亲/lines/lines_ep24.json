  "lines": [
    {
      "t": 0,
      "text": "你把事情闹大"
    },
    {
      "t": 2,
      "text": "以后谁还愿意推荐你"
    },
    {
      "t": 4,
      "text": "愿不愿意推荐是别人的选择"
    },
    {
      "t": 6,
      "text": "把没发生的事写成我做的"
    },
    {
      "t": 8,
      "text": "我得说清楚"
    },
    {
      "t": 10,
      "text": "需要我处理什么"
    },
    {
      "t": 12,
      "text": "他在等核验"
    },
    {
      "t": 14,
      "text": "请帮忙维持通道就好"
    },
    {
      "t": 18,
      "text": "通知上写的是推荐人撤回"
    },
    {
      "t": 22,
      "text": "备注一起留存"
    },
    {
      "t": 24,
      "text": "你真要在第一天就"
    },
    {
      "t": 26,
      "text": "投诉负责招聘的人"
    },
    {
      "t": 28,
      "text": "我在说明我没做过什么"
    },
    {
      "t": 30,
      "text": "你若没写错"
    },
    {
      "t": 34,
      "text": "周叔叔他既然不用您的推荐"
    },
    {
      "t": 36,
      "text": "能不能给给我"
    },
    {
      "t": 40,
      "text": "先把你的简历交齐"
    },
    {
      "t": 42,
      "text": "以前他有成绩有奖"
    },
    {
      "t": 44,
      "text": "周承就替他跑前跑后"
    },
    {
      "t": 46,
      "text": "现在我跟周承在一起了"
    }
  ]
}