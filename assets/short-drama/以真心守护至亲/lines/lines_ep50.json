  "lines": [
    {
      "t": 0,
      "text": "是他拿这种话差辱人"
    },
    {
      "t": 2,
      "text": "我不让他爬"
    },
    {
      "t": 4,
      "text": "但不能装没说过"
    },
    {
      "t": 6,
      "text": "非得把事情做绝"
    },
    {
      "t": 8,
      "text": "认输等宁宁下来"
    },
    {
      "t": 10,
      "text": "向他当面道"
    },
    {
      "t": 12,
      "text": "给人扣帽子的时候"
    },
    {
      "t": 14,
      "text": "你没想过给他留余地"
    },
    {
      "t": 16,
      "text": "现在只要你承认说错很难吗"
    },
    {
      "t": 18,
      "text": "赌是我输了"
    },
    {
      "t": 20,
      "text": "许宁办成了入职我认"
    },
    {
      "t": 24,
      "text": "还有道款"
    },
    {
      "t": 28,
      "text": "我当面说"
    },
    {
      "t": 34,
      "text": "公共展区可以等家属"
    },
    {
      "t": 36,
      "text": "这里有水"
    },
    {
      "t": 40,
      "text": "谢谢我在外面等"
    },
    {
      "t": 48,
      "text": "脚放稳我把垫子理一下"
    },
    {
      "t": 50,
      "text": "坐久了有一点"
    },
    {
      "t": 54,
      "text": "就什么都不顾了"
    }
  ]
}