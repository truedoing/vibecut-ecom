  "frame_count": 51,
  "line_count": 30,
  "lines": [
    {
      "t": 0.0,
      "text": "还没看够就让你难成这样"
    },
    {
      "t": 4.0,
      "text": "妈心里不好受"
    },
    {
      "t": 6.0,
      "text": "你妈都知道该怎么办"
    },
    {
      "t": 8.0,
      "text": "你还拦着干什么"
    },
    {
      "t": 9.0,
      "text": "他怕我为难"
    },
    {
      "t": 10.0,
      "text": "不是你们做的对"
    },
    {
      "t": 11.0,
      "text": "姐跟周承上台吧"
    },
    {
      "t": 13.0,
      "text": "他又不是不会转轮子"
    },
    {
      "t": 14.0,
      "text": "出去等一会怎么了"
    },
    {
      "t": 17.0,
      "text": "小的时候"
    },
    {
      "t": 18.0,
      "text": "妈怕我冻着"
    },
    {
      "t": 19.0,
      "text": "自己的棉袄都脱给我"
    },
    {
      "t": 21.0,
      "text": "今天我穿着婚纱"
    },
    {
      "t": 23.0,
      "text": "倒要看着他被赶出去"
    },
    {
      "t": 26.0,
      "text": "又拿小时候说事"
    },
    {
      "t": 28.0,
      "text": "他这些年管过你什么"
    },
    {
      "t": 29.0,
      "text": "给你交过学费"
    },
    {
      "t": 31.0,
      "text": "还是帮你找过工作"
    },
    {
      "t": 32.0,
      "text": "是我欠你们的"
    },
    {
      "t": 34.0,
      "text": "可欠的这些"
    },
    {
      "t": 35.0,
      "text": "你冲妈来"
    },
    {
      "t": 36.0,
      "text": "别再逼你姐姐"
    },
    {
      "t": 37.0,
      "text": "我们没功夫算你们家的账"
    },
    {
      "t": 40.0,
      "text": "要么说清楚"
    },
    {
      "t": 42.0,
      "text": "要么带着她走"
    },
    {
      "t": 43.0,
      "text": "工作也不用等了"
    },
    {
      "t": 47.0,
      "text": "把她送出去"
    },
    {
      "t": 48.0,
      "text": "回来戴戒指"
    },
    {
      "t": 49.0,
      "text": "以后你就是我家的人"
    },
    {
      "t": 50.0,
      "text": "谁也不会为难你"
    }
  ]
}