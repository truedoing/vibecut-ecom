  "lines": [
    {
      "t": 0.0,
      "text": "房子是我的"
    },
    {
      "t": 2.0,
      "text": "你换锁跟我说过没有"
    },
    {
      "t": 4.0,
      "text": "姐为了间租的房子"
    },
    {
      "t": 7.0,
      "text": "你非把大家闹得难看"
    },
    {
      "t": 10.0,
      "text": "换锁扔我东西的人不是我"
    },
    {
      "t": 17.0,
      "text": "宁宁妈陪你等"
    },
    {
      "t": 19.0,
      "text": "自己的东西"
    },
    {
      "t": 20.0,
      "text": "一样也不能让他们糟蹋"
    },
    {
      "t": 22.0,
      "text": "签合同时就写清楚了"
    },
    {
      "t": 24.0,
      "text": "许宁实际住"
    },
    {
      "t": 25.0,
      "text": "实际付租"
    },
    {
      "t": 26.0,
      "text": "你们要变更"
    },
    {
      "t": 27.0,
      "text": "明天三方来谈"
    },
    {
      "t": 28.0,
      "text": "今晚不能把她堵在外面"
    },
    {
      "t": 30.0,
      "text": "我也是签合同的人"
    },
    {
      "t": 31.0,
      "text": "所以明天当面写清楚"
    },
    {
      "t": 33.0,
      "text": "现在先把钥匙给她"
    },
    {
      "t": 35.0,
      "text": "她的书和衣服也放回原位"
    },
    {
      "t": 36.0,
      "text": "周成今天可是我们结婚"
    },
    {
      "t": 39.0,
      "text": "她说不嫁就不嫁"
    },
    {
      "t": 40.0,
      "text": "现在还要赶咱们走"
    },
    {
      "t": 41.0,
      "text": "你们想住哪里自已租"
    },
    {
      "t": 43.0,
      "text": "你就剩这点钱撑着了"
    },
    {
      "t": 44.0,
      "text": "工作没了"
    },
    {
      "t": 45.0,
      "text": "还带着你妈"
    },
    {
      "t": 46.0,
      "text": "以后怎么办"
    },
    {
      "t": 47.0,
      "text": "他以后过得怎么样"
    },
    {
      "t": 48.0,
      "text": "也不是你欺负他的理由"
    }
  ]
}