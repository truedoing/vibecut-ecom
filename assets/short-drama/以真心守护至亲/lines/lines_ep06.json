  "lines": [
    {
      "t": 0.0,
      "text": "爸大家都等着呢"
    },
    {
      "t": 2.0,
      "text": "让他自己想清楚"
    },
    {
      "t": 4.0,
      "text": "许宁"
    },
    {
      "t": 6.0,
      "text": "先把人送走"
    },
    {
      "t": 7.0,
      "text": "再回来谈这婚怎么结"
    },
    {
      "t": 9.0,
      "text": "如果我不送呢"
    },
    {
      "t": 10.0,
      "text": "那就不光是婚礼办不下去了"
    },
    {
      "t": 12.0,
      "text": "你进弘业的事也别想了"
    },
    {
      "t": 14.0,
      "text": "你的项目成绩我都收到了"
    },
    {
      "t": 17.0,
      "text": "今年校招我负责"
    },
    {
      "t": 18.0,
      "text": "推荐还是撤回"
    },
    {
      "t": 20.0,
      "text": "就看你今天懂不懂事"
    },
    {
      "t": 23.0,
      "text": "我投工作交的是自己的材料"
    },
    {
      "t": 25.0,
      "text": "我认不认妈妈跟"
    },
    {
      "t": 28.0,
      "text": "连两家人的脸面都顾不好"
    },
    {
      "t": 30.0,
      "text": "进了公司你能顾好什么"
    },
    {
      "t": 32.0,
      "text": "招聘该看他能不能做事"
    },
    {
      "t": 34.0,
      "text": "不能因为他认了我"
    },
    {
      "t": 36.0,
      "text": "就把他的本事抹了"
    },
    {
      "t": 37.0,
      "text": "我跟他说话"
    },
    {
      "t": 38.0,
      "text": "轮不到您教我怎么招人"
    },
    {
      "t": 40.0,
      "text": "你先把他送出去"
    },
    {
      "t": 41.0,
      "text": "等客人走了"
    },
    {
      "t": 42.0,
      "text": "想见多久都行"
    },
    {
      "t": 43.0,
      "text": "非得现在跟我爸顶"
    },
    {
      "t": 46.0,
      "text": "你知道她是我妈妈"
    },
    {
      "t": 48.0,
      "text": "还要我把她赶出去"
    }
  ]
}