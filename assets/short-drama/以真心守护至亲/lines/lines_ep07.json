  "step": 1.0,
  "frame_count": 51,
  "line_count": 29,
  "lines": [
    {
      "t": 0.0,
      "text": "我还知道今天是咱俩结婚"
    },
    {
      "t": 2.0,
      "text": "你想让我成为所有人的笑话"
    },
    {
      "t": 5.0,
      "text": "姐你就听一次劝"
    },
    {
      "t": 7.0,
      "text": "成绩再好"
    },
    {
      "t": 8.0,
      "text": "工作还不是要靠周叔叔"
    },
    {
      "t": 9.0,
      "text": "别拿自己的前途赌气"
    },
    {
      "t": 11.0,
      "text": "我不是赌气"
    },
    {
      "t": 13.0,
      "text": "我连让妈坐下的"
    },
    {
      "t": 14.0,
      "text": "地方都争不到"
    },
    {
      "t": 15.0,
      "text": "今天这婚结完以后呢"
    },
    {
      "t": 17.0,
      "text": "你有婚结"
    },
    {
      "t": 18.0,
      "text": "有工作去"
    },
    {
      "t": 19.0,
      "text": "还不知足"
    },
    {
      "t": 20.0,
      "text": "别人想要都没有"
    },
    {
      "t": 21.0,
      "text": "你们要的是他把我送走"
    },
    {
      "t": 23.0,
      "text": "还是让他以后都不认我"
    },
    {
      "t": 25.0,
      "text": "人出去事情才说得下去许宁"
    },
    {
      "t": 29.0,
      "text": "你自己跟大家说是认错人了"
    },
    {
      "t": 31.0,
      "text": "再让他从旁门离开"
    },
    {
      "t": 33.0,
      "text": "说清楚婚礼继续"
    },
    {
      "t": 35.0,
      "text": "推荐也还在"
    },
    {
      "t": 37.0,
      "text": "你要我当着我妈的"
    },
    {
      "t": 38.0,
      "text": "面说她不是我妈"
    },
    {
      "t": 40.0,
      "text": "我是在给你留路你选"
    },
    {
      "t": 44.0,
      "text": "宁宁妈先去外面等你"
    },
    {
      "t": 46.0,
      "text": "别为了妈把"
    },
    {
      "t": 47.0,
      "text": "你自己的路堵死了"
    },
    {
      "t": 49.0,
      "text": "你又没做错事"
    },
    {
      "t": 50.0,
      "text": "为什么要躲到外面"
    }
  ]
}