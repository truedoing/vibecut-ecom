  "lines": [
    {
      "t": 0.0,
      "text": "电子资料我发给你"
    },
    {
      "t": 2.0,
      "text": "分工和记录都齐"
    },
    {
      "t": 4.0,
      "text": "岗位不合适也别为难人家"
    },
    {
      "t": 8.0,
      "text": "好妈现在转过去"
    },
    {
      "t": 11.0,
      "text": "明天证件带齐"
    },
    {
      "t": 12.0,
      "text": "做过什么就说什么"
    },
    {
      "t": 16.0,
      "text": "妈今晚你睡床"
    },
    {
      "t": 18.0,
      "text": "我打地铺"
    },
    {
      "t": 19.0,
      "text": "挪过去我扶着"
    },
    {
      "t": 20.0,
      "text": "你腿能使一点力吗"
    },
    {
      "t": 24.0,
      "text": "能扶着挪几步"
    },
    {
      "t": 26.0,
      "text": "洪水时伤的左腿"
    },
    {
      "t": 28.0,
      "text": "久站久走就疼"
    },
    {
      "t": 30.0,
      "text": "出门靠轮椅"
    },
    {
      "t": 32.0,
      "text": "你别慌慢一点就好"
    },
    {
      "t": 34.0,
      "text": "那就按时复查"
    },
    {
      "t": 36.0,
      "text": "疼了告诉我"
    },
    {
      "t": 37.0,
      "text": "别为了少花钱硬撑"
    },
    {
      "t": 39.0,
      "text": "床边给你留着灯"
    },
    {
      "t": 47.0,
      "text": "好以后有事"
    },
    {
      "t": 50.0,
      "text": "咱们一起想办法"
    }
  ]
}