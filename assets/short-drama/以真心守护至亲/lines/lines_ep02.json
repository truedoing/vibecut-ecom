  "step": 1.0,
  "frame_count": 55,
  "line_count": 33,
  "lines": [
    {
      "t": 0.0,
      "text": "你6岁那年"
    },
    {
      "t": 1.0,
      "text": "着脚端汤锅翻了"
    },
    {
      "t": 3.0,
      "text": "妈伸手一挡"
    },
    {
      "t": 4.0,
      "text": "汤全泼在手上"
    },
    {
      "t": 5.0,
      "text": "你哭着给妈吹"
    },
    {
      "t": 6.0,
      "text": "说长大了挣钱带妈去治"
    },
    {
      "t": 9.0,
      "text": "妈真的是你"
    },
    {
      "t": 10.0,
      "text": "他们都说你没了"
    },
    {
      "t": 11.0,
      "text": "我和晴晴等了你好久"
    },
    {
      "t": 13.0,
      "text": "妈回来了"
    },
    {
      "t": 15.0,
      "text": "宁宁妈对不起你们"
    },
    {
      "t": 20.0,
      "text": "晴晴"
    },
    {
      "t": 21.0,
      "text": "这是妈"
    },
    {
      "t": 24.0,
      "text": "既然是亲妈"
    },
    {
      "t": 25.0,
      "text": "女儿今天结婚"
    },
    {
      "t": 26.0,
      "text": "新婚礼物呢"
    },
    {
      "t": 28.0,
      "text": "总不能空着手来做亲家席吧"
    },
    {
      "t": 32.0,
      "text": "我妈能回来就是最好的礼物"
    },
    {
      "t": 35.0,
      "text": "你高兴就够了"
    },
    {
      "t": 36.0,
      "text": "酒席婚庆哪样不是我家出钱"
    },
    {
      "t": 38.0,
      "text": "她17年没管你"
    },
    {
      "t": 39.0,
      "text": "今天来当现成的丈母娘"
    },
    {
      "t": 40.0,
      "text": "这些年我什么都没了"
    },
    {
      "t": 42.0,
      "text": "就只剩这把轮椅"
    },
    {
      "t": 43.0,
      "text": "等妈不在了"
    },
    {
      "t": 44.0,
      "text": "就留给你们姐妹俩"
    },
    {
      "t": 45.0,
      "text": "新婚礼物就一把破轮椅"
    },
    {
      "t": 47.0,
      "text": "是盼着谁坐"
    },
    {
      "t": 48.0,
      "text": "我周家的亲家就拿"
    },
    {
      "t": 50.0,
      "text": "这东西让人笑话"
    },
    {
      "t": 52.0,
      "text": "谁要你的破轮椅"
    },
    {
      "t": 53.0,
      "text": "我又没瘤"
    },
    {
      "t": 54.0,
      "text": "留给我干什么"
    }
  ]
}