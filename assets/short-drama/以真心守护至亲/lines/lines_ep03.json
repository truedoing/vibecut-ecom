  "step": 1.0,
  "frame_count": 50,
  "line_count": 30,
  "lines": [
    {
      "t": 0.0,
      "text": "姐姐愿意认你"
    },
    {
      "t": 1.0,
      "text": "都给她好了"
    },
    {
      "t": 3.0,
      "text": "晴晴"
    },
    {
      "t": 5.0,
      "text": "这是妈想留给你们的"
    },
    {
      "t": 8.0,
      "text": "别我不要"
    },
    {
      "t": 9.0,
      "text": "自送都不要"
    },
    {
      "t": 10.0,
      "text": "你赶紧走"
    },
    {
      "t": 11.0,
      "text": "别耽误我姐结婚"
    },
    {
      "t": 14.0,
      "text": "这轮椅不能再这么坐了"
    },
    {
      "t": 16.0,
      "text": "妈你等我一下"
    },
    {
      "t": 19.0,
      "text": "看见了吧"
    },
    {
      "t": 20.0,
      "text": "他也嫌破"
    },
    {
      "t": 21.0,
      "text": "还真当自己送了什么宝贝"
    },
    {
      "t": 23.0,
      "text": "宁宁你去哪"
    },
    {
      "t": 26.0,
      "text": "推着这把破轮椅跟来"
    },
    {
      "t": 28.0,
      "text": "让他以后怎么抬头"
    },
    {
      "t": 29.0,
      "text": "人家都跑了"
    },
    {
      "t": 30.0,
      "text": "你还看不明自谁是"
    },
    {
      "t": 32.0,
      "text": "谁愿意结婚当天"
    },
    {
      "t": 33.0,
      "text": "多出这么个拖累"
    },
    {
      "t": 35.0,
      "text": "宁宁说让我等他"
    },
    {
      "t": 37.0,
      "text": "那是给你留脸"
    },
    {
      "t": 38.0,
      "text": "非得他亲口赶你"
    },
    {
      "t": 39.0,
      "text": "你才肯走"
    },
    {
      "t": 40.0,
      "text": "难道两个孩子真"
    },
    {
      "t": 42.0,
      "text": "的都不要我了"
    },
    {
      "t": 43.0,
      "text": "我找了17年"
    },
    {
      "t": 45.0,
      "text": "为什么还非要拿这副"
    },
    {
      "t": 46.0,
      "text": "穷样子来试他们的心"
    },
    {
      "t": 49.0,
      "text": "妈垫子拿来了"
    }
  ]
}