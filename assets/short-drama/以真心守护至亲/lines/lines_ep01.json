{
  "ep": 1,
  "file": "1.mp4",
  "duration": 99.01,
  "step": 1.0,
  "frame_count": 99,
  "line_count": 49,
  "lines": [
    {
      "t": 1.0,
      "text": "我把50斤黄金做成轮椅"
    },
    {
      "t": 3.0,
      "text": "刷上黑漆"
    },
    {
      "t": 5.0,
      "text": "穿着破衣服去女儿的婚礼"
    },
    {
      "t": 7.0,
      "text": "就为了试试"
    },
    {
      "t": 8.0,
      "text": "失散17年的两个女儿"
    },
    {
      "t": 10.0,
      "text": "还认不认我这个穷妈"
    },
    {
      "t": 11.0,
      "text": "请新郎牵起新娘的手"
    },
    {
      "t": 16.0,
      "text": "我是妈妈"
    },
    {
      "t": 17.0,
      "text": "妈终于找到你了"
    },
    {
      "t": 23.0,
      "text": "可我妈妈17年前就没了"
    },
    {
      "t": 25.0,
      "text": "妈没死"
    },
    {
      "t": 27.0,
      "text": "那年发大水"
    },
    {
      "t": 29.0,
      "text": "妈把你和妹妹抱上救援船"
    },
    {
      "t": 31.0,
      "text": "回头就被水冲走了"
    },
    {
      "t": 34.0,
      "text": "这17年妈一直在找你们"
    },
    {
      "t": 37.0,
      "text": "找了17年"
    },
    {
      "t": 38.0,
      "text": "偏偏挑我结婚这天来"
    },
    {
      "t": 40.0,
      "text": "你推着把破轮椅"
    },
    {
      "t": 41.0,
      "text": "张嘴就认女儿谁信"
    },
    {
      "t": 43.0,
      "text": "女儿结婚"
    },
    {
      "t": 44.0,
      "text": "我这个当妈的还不能来"
    },
    {
      "t": 46.0,
      "text": "来的都是亲戚领导"
    },
    {
      "t": 48.0,
      "text": "冒出你这么个亲家"
    },
    {
      "t": 50.0,
      "text": "让人怎么看"
    },
    {
      "t": 51.0,
      "text": "我们周家丢不起这个人"
    },
    {
      "t": 53.0,
      "text": "你也配"
    },
    {
      "t": 55.0,
      "text": "哪来的老婆子"
    },
    {
      "t": 56.0,
      "text": "跑到我姐婚礼上认女儿"
    },
    {
      "t": 57.0,
      "text": "你当我们好骗"
    },
    {
      "t": 59.0,
      "text": "晴晴"
    },
    {
      "t": 60.0,
      "text": "你是晴睛"
    },
    {
      "t": 61.0,
      "text": "我是妈呀"
    },
    {
      "t": 62.0,
      "text": "你仔细看看"
    },
    {
      "t": 63.0,
      "text": "别叫我我们没妈"
    },
    {
      "t": 65.0,
      "text": "你少往自己脸上贴金"
    },
    {
      "t": 67.0,
      "text": "许宁工作是我爸替你安排的"
    },
    {
      "t": 69.0,
      "text": "婚礼也是我们家办的"
    },
    {
      "t": 71.0,
      "text": "你别为了他让我"
    },
    {
      "t": 72.0,
      "text": "全家下不来台"
    },
    {
      "t": 75.0,
      "text": "跟这种疯婆子有什么好说的"
    },
    {
      "t": 76.0,
      "text": "保安把她弄出去"
    },
    {
      "t": 80.0,
      "text": "先别推"
    },
    {
      "t": 81.0,
      "text": "她坐着轮椅"
    },
    {
      "t": 84.0,
      "text": "姐宾客都看着呢"
    },
    {
      "t": 85.0,
      "text": "你不要脸面也替周家想想"
    },
    {
      "t": 87.0,
      "text": "她没伤人也没要钱"
    },
    {
      "t": 89.0,
      "text": "是不是认错让我问清楚"
    },
    {
      "t": 94.0,
      "text": "这道疤是不是替我"
    },
    {
      "t": 97.0,
      "text": "挡那锅热汤烫的"
    }
  ]
}