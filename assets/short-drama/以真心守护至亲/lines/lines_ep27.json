    {
      "t": 0,
      "text": "有个急办通知就算入职"
    },
    {
      "t": 2,
      "text": "他自己都没看见"
    },
    {
      "t": 6,
      "text": "你要面试也先准备"
    },
    {
      "t": 8,
      "text": "别只町着我能不能办成"
    },
    {
      "t": 12,
      "text": "你非要弄到周叔叔下不来台"
    },
    {
      "t": 16,
      "text": "帮过我记得"
    },
    {
      "t": 18,
      "text": "发生的事记到我名下"
    },
    {
      "t": 24,
      "text": "等罗主管来"
    },
    {
      "t": 26,
      "text": "办给的什么安排"
    },
    {
      "t": 30,
      "text": "罗主管许小姐在这里"
    },
    {
      "t": 32,
      "text": "许宁小姐"
    },
    {
      "t": 34,
      "text": "来给您办手续"
    },
    {
      "t": 38,
      "text": "等一下"
    },
    {
      "t": 40,
      "text": "他昨天的内推已经撤回"
    },
    {
      "t": 46,
      "text": "董事办送来的录用审批"
    },
    {
      "t": 48,
      "text": "跟您的内推不是一回事"
    }
  ]
}