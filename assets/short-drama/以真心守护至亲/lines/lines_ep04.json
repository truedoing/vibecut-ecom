  "lines": [
    {
      "t": 0.0,
      "text": "妈你慢点坐"
    },
    {
      "t": 2.0,
      "text": "还確不"
    },
    {
      "t": 5.0,
      "text": "不了"
    },
    {
      "t": 6.0,
      "text": "你刚才跑走就为拿这个"
    },
    {
      "t": 9.0,
      "text": "硬框都露出来了"
    },
    {
      "t": 11.0,
      "text": "坐久了多疼"
    },
    {
      "t": 12.0,
      "text": "妈还以为你也嫌我"
    },
    {
      "t": 16.0,
      "text": "我嫌的是这硬框着你"
    },
    {
      "t": 18.0,
      "text": "不是嫌你"
    },
    {
      "t": 19.0,
      "text": "妈我好不容易找到你"
    },
    {
      "t": 22.0,
      "text": "怎么舍得不要你"
    },
    {
      "t": 23.0,
      "text": "认完就行了"
    },
    {
      "t": 24.0,
      "text": "让她去后面坐"
    },
    {
      "t": 26.0,
      "text": "别耽误仪式"
    },
    {
      "t": 27.0,
      "text": "家属都坐主桌"
    },
    {
      "t": 29.0,
      "text": "我妈为什么坐后面"
    },
    {
      "t": 31.0,
      "text": "我爸旁边坐的都是领导"
    },
    {
      "t": 33.0,
      "text": "她穿成这样"
    },
    {
      "t": 34.0,
      "text": "让人问起来"
    },
    {
      "t": 35.0,
      "text": "我怎么介绍"
    },
    {
      "t": 36.0,
      "text": "就说是我妈妈"
    },
    {
      "t": 38.0,
      "text": "难道要我把她藏起来"
    },
    {
      "t": 41.0,
      "text": "晴晴把椅子往旁边挪一点"
    },
    {
      "t": 43.0,
      "text": "给妈留个位置"
    },
    {
      "t": 45.0,
      "text": "我说了主桌不行"
    }
  ]
