{
  "ep": 5,
  "file": "5.mp4",
  "duration": 56.89,
  "step": 1.0,
  "frame_count": 57,
  "line_count": 36,
  "lines": [
    {
      "t": 1.0,
      "text": "谁让她坐这的"
    },
    {
      "t": 2.0,
      "text": "周叔叔这是我妈妈林秀兰"
    },
    {
      "t": 4.0,
      "text": "我们今天刚找到彼此"
    },
    {
      "t": 6.0,
      "text": "我想让她坐我这边"
    },
    {
      "t": 7.0,
      "text": "我听见了"
    },
    {
      "t": 9.0,
      "text": "可今天是两家的婚礼"
    },
    {
      "t": 10.0,
      "text": "不是你一个人的认亲大会"
    },
    {
      "t": 12.0,
      "text": "我来看看女儿"
    },
    {
      "t": 13.0,
      "text": "不会耽误你们的事"
    },
    {
      "t": 16.0,
      "text": "您坐在这就已经耽误了"
    },
    {
      "t": 19.0,
      "text": "大家敬酒问起亲家做什么"
    },
    {
      "t": 20.0,
      "text": "住哪"
    },
    {
      "t": 22.0,
      "text": "您怎么答"
    },
    {
      "t": 23.0,
      "text": "您要问可以好好问"
    },
    {
      "t": 25.0,
      "text": "他不是见不得人的人"
    },
    {
      "t": 27.0,
      "text": "许宁我爸已经够给你面子了"
    },
    {
      "t": 29.0,
      "text": "你还想让他陪着你丢脸"
    },
    {
      "t": 30.0,
      "text": "姐妈真替你着想"
    },
    {
      "t": 32.0,
      "text": "就该自己去后面"
    },
    {
      "t": 33.0,
      "text": "非得让大家看笑话"
    },
    {
      "t": 34.0,
      "text": "晴晴"
    },
    {
      "t": 35.0,
      "text": "我坐你旁边就这么让你难堪"
    },
    {
      "t": 39.0,
      "text": "你非要我说难听的"
    },
    {
      "t": 40.0,
      "text": "今天来的人"
    },
    {
      "t": 41.0,
      "text": "谁不是穿的体体面面"
    },
    {
      "t": 43.0,
      "text": "妈的外套旧不脏"
    },
    {
      "t": 44.0,
      "text": "她也没坐过你的位置"
    },
    {
      "t": 45.0,
      "text": "你推什么"
    },
    {
      "t": 46.0,
      "text": "宁宁妈坐后面也看得见你"
    },
    {
      "t": 49.0,
      "text": "别为了一个位置吵了"
    },
    {
      "t": 50.0,
      "text": "不是位置"
    },
    {
      "t": 51.0,
      "text": "你今天推到后面"
    },
    {
      "t": 52.0,
      "text": "以后他们还会让"
    },
    {
      "t": 53.0,
      "text": "我把你往哪放"
    },
    {
      "t": 54.0,
      "text": "仪式先停"
    },
    {
      "t": 55.0,
      "text": "音乐也关了"
    }
  ]
}