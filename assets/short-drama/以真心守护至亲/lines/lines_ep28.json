    {
      "t": 0,
      "text": "他跟我一起毕业"
    },
    {
      "t": 4,
      "text": "昨天我就没求过他"
    },
    {
      "t": 6,
      "text": "婚礼上出租屋里你都在"
    },
    {
      "t": 10,
      "text": "昨天还得求周叔叔"
    },
    {
      "t": 12,
      "text": "今天就有董事办给他安排"
    },
    {
      "t": 16,
      "text": "有个急办通知就"
    },
    {
      "t": 18,
      "text": "先看看里面写的什么"
    },
    {
      "t": 20,
      "text": "许宁今天真能领到工牌"
    },
    {
      "t": 22,
      "text": "在场的人都能作证"
    },
    {
      "t": 24,
      "text": "我来工作"
    },
    {
      "t": 26,
      "text": "你先让开"
    },
    {
      "t": 28,
      "text": "不敢接你要办不成"
    },
    {
      "t": 30,
      "text": "就带着你妈离开"
    },
    {
      "t": 34,
      "text": "就是你妈说什么你都信"
    },
    {
      "t": 36,
      "text": "也该看看现实了"
    },
    {
      "t": 38,
      "text": "两位办理人是我"
    },
    {
      "t": 40,
      "text": "不由你们下结论"
    },
    {
      "t": 46,
      "text": "董事办直签研发部"
    }
