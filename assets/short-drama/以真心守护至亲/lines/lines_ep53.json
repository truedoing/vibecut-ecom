  "lines": [
    {
      "t": 0,
      "text": "他给机会我感谢"
    },
    {
      "t": 2,
      "text": "但真要我在没核"
    },
    {
      "t": 4,
      "text": "过的结论上签字我不签"
    },
    {
      "t": 6,
      "text": "否则今天保住面子"
    },
    {
      "t": 8,
      "text": "明天出问题"
    },
    {
      "t": 12,
      "text": "话能说的这么明白"
    },
    {
      "t": 14,
      "text": "你若没过"
    },
    {
      "t": 16,
      "text": "资料交接的活照做"
    },
    {
      "t": 18,
      "text": "别觉得是在羞辱你"
    },
    {
      "t": 20,
      "text": "我接受基础活也得有人做"
    },
    {
      "t": 22,
      "text": "看见我能做到哪一步"
    },
    {
      "t": 24,
      "text": "宁宁妈在展柜那边等你"
    },
    {
      "t": 28,
      "text": "考出来什么结果都不用怕"
    },
    {
      "t": 30,
      "text": "知道你不替我着急"
    },
    {
      "t": 32,
      "text": "我就更能把心放在题上"
    },
    {
      "t": 36,
      "text": "家属放心"
    },
    {
      "t": 38,
      "text": "不是逼他当场做出新成果"
    },
    {
      "t": 42,
      "text": "承认比硬编强"
    },
    {
      "t": 46,
      "text": "这是给新人用的公开旧案例"
    }
  ]
}