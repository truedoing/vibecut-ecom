    {
      "t": 0,
      "text": "坏的也留在这里"
    },
    {
      "t": 2,
      "text": "别人来参观不怕"
    },
    {
      "t": 4,
      "text": "这是同一项涂层"
    },
    {
      "t": 6,
      "text": "研究的两个阶段"
    },
    {
      "t": 8,
      "text": "旧样品裂过"
    },
    {
      "t": 10,
      "text": "把工艺改过来"
    },
    {
      "t": 12,
      "text": "新人看完也知道"
    },
    {
      "t": 14,
      "text": "成品不是凭空来的"
    },
    {
      "t": 16,
      "text": "有些东西摔过改过"
    },
    {
      "t": 20,
      "text": "才知道哪里该拖住"
    },
    {
      "t": 22,
      "text": "妈你这是说样品还是说咱俩"
    },
    {
      "t": 24,
      "text": "说我自己"
    },
    {
      "t": 26,
      "text": "咋天怕你丢工作"
    },
    {
      "t": 28,
      "text": "差点又替你退了"
    },
    {
      "t": 30,
      "text": "今天你争到了次机会"
    },
    {
      "t": 32,
      "text": "妈得学着坐在外面等"
    },
    {
      "t": 34,
      "text": "不替你把路都选好"
    },
    {
      "t": 36,
      "text": "方主管可以见你了"
    },
    {
      "t": 38,
      "text": "具体任务还得自己谈"
    },
    {
      "t": 44,
      "text": "妈你就在这里"
    },
    {
      "t": 46,
      "text": "别又一个人往外挪"
    }
