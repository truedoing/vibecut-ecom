  "lines": [
    {
      "t": 0.0,
      "text": "岗位先落实"
    },
    {
      "t": 1.0,
      "text": "钱和股权等我跟他说"
    },
    {
      "t": 4.0,
      "text": "今天他把唯一的床让给我"
    },
    {
      "t": 6.0,
      "text": "我却让他以为我"
    },
    {
      "t": 7.0,
      "text": "真的一无所有"
    },
    {
      "t": 8.0,
      "text": "那您的身份还瞒着"
    },
    {
      "t": 13.0,
      "text": "钱的事不能再骗他"
    },
    {
      "t": 14.0,
      "text": "我会先告诉他确实有股份"
    },
    {
      "t": 17.0,
      "text": "职务先不公开"
    },
    {
      "t": 18.0,
      "text": "别让招聘变成认老板的女儿"
    },
    {
      "t": 20.0,
      "text": "你把岗位和家里的赠与分开"
    },
    {
      "t": 22.0,
      "text": "他肯收什么"
    },
    {
      "t": 23.0,
      "text": "要听他的"
    },
    {
      "t": 28.0,
      "text": "明白"
    },
    {
      "t": 29.0,
      "text": "给许宁小姐的欢迎安排还做吗"
    },
    {
      "t": 31.0,
      "text": "照原计划准备"
    },
    {
      "t": 32.0,
      "text": "等他办好再启动"
    },
    {
      "t": 33.0,
      "text": "NE"
    },
    {
      "t": 34.0,
      "text": "别让周德海卡住他"
    },
    {
      "t": 38.0,
      "text": "您还穿这件回去"
    },
    {
      "t": 39.0,
      "text": "宁宁怕我冷"
    },
    {
      "t": 41.0,
      "text": "跑着拿回来的"
    },
    {
      "t": 42.0,
      "text": "明天他去上班"
    },
    {
      "t": 44.0,
      "text": "我也得让他知道"
    },
    {
      "t": 45.0,
      "text": "他妈妈不是只能拖累他"
    }
  ]
