  "line_count": 25,
  "lines": [
    {
      "t": 0.0,
      "text": "成为你家的人"
    },
    {
      "t": 1.0,
      "text": "就得先不认自己的妈"
    },
    {
      "t": 3.0,
      "text": "你一定要把话说成这样"
    },
    {
      "t": 4.0,
      "text": "宁宁妈不想让你后悔"
    },
    {
      "t": 15.0,
      "text": "你干什么"
    },
    {
      "t": 17.0,
      "text": "证还没领"
    },
    {
      "t": 18.0,
      "text": "这婚我不结了"
    },
    {
      "t": 19.0,
      "text": "戒指我也不戴"
    },
    {
      "t": 21.0,
      "text": "你想好了"
    },
    {
      "t": 23.0,
      "text": "你现在走就是打我周家的脸"
    },
    {
      "t": 26.0,
      "text": "我想继续结婚"
    },
    {
      "t": 27.0,
      "text": "你们让我先不认他"
    },
    {
      "t": 30.0,
      "text": "是你们把事情逼到这一步的"
    },
    {
      "t": 32.0,
      "text": "我对你还不够好"
    },
    {
      "t": 33.0,
      "text": "工作婚礼"
    },
    {
      "t": 34.0,
      "text": "我哪一样没替你安排"
    },
    {
      "t": 37.0,
      "text": "我以为你愿意跟我过日子"
    },
    {
      "t": 39.0,
      "text": "现在才知道"
    },
    {
      "t": 40.0,
      "text": "你给我这些是为了"
    },
    {
      "t": 42.0,
      "text": "让我什么都听你的别碰我"
    },
    {
      "t": 44.0,
      "text": "姐你现在闹着走"
    },
    {
      "t": 46.0,
      "text": "过后可别后悔"
    },
    {
      "t": 47.0,
      "text": "不是谁都能嫁进"
    },
    {
      "t": 48.0,
      "text": "周家进弘业的"
    },
    {
      "t": 49.0,
      "text": "那也不能拿我妈来换"
    }
  ]
}