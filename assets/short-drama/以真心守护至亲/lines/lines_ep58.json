  "lines": [
    {
      "t": 0,
      "text": "道歉我听见了"
    },
    {
      "t": 2,
      "text": "以后别再拿我妈当"
    },
    {
      "t": 8,
      "text": "今天是你自己过的考核"
    },
    {
      "t": 10,
      "text": "现在可以踏实跟我回楼上了"
    },
    {
      "t": 14,
      "text": "你答应讲的那些年"
    },
    {
      "t": 22,
      "text": "洪水后我被人救走"
    },
    {
      "t": 26,
      "text": "听到的都没消息"
    },
    {
      "t": 28,
      "text": "后来能坐着做些活了"
    },
    {
      "t": 30,
      "text": "就一边挣钱一边找你们"
    },
    {
      "t": 34,
      "text": "腿落下的毛病一直得照看"
    },
    {
      "t": 36,
      "text": "你一个人找了17年"
    },
    {
      "t": 42,
      "text": "再后来跟人做生意"
    },
    {
      "t": 44,
      "text": "有了弘业的股份"
    },
    {
      "t": 46,
      "text": "也请人找"
    }
  ]
