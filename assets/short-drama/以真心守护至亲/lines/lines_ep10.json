  "frame_count": 51,
  "line_count": 28,
  "lines": [
    {
      "t": 0.0,
      "text": "各位今天没能让大家"
    },
    {
      "t": 2.0,
      "text": "好好吃这顿饭对不起"
    },
    {
      "t": 4.0,
      "text": "这位是我妈妈林秀兰"
    },
    {
      "t": 5.0,
      "text": "我们失散了17年"
    },
    {
      "t": 6.0,
      "text": "今天才找到彼此"
    },
    {
      "t": 7.0,
      "text": "她不是疯子"
    },
    {
      "t": 8.0,
      "text": "也不是来讨钱的"
    },
    {
      "t": 9.0,
      "text": "我不可能今天认回她"
    },
    {
      "t": 11.0,
      "text": "再亲手把她赶出去"
    },
    {
      "t": 12.0,
      "text": "婚礼不办了"
    },
    {
      "t": 13.0,
      "text": "我先带妈妈回家"
    },
    {
      "t": 14.0,
      "text": "行你出去以后"
    },
    {
      "t": 15.0,
      "text": "别再想让我推荐你进弘业"
    },
    {
      "t": 18.0,
      "text": "我做过的项目"
    },
    {
      "t": 19.0,
      "text": "学过的东西都还在"
    },
    {
      "t": 21.0,
      "text": "我会自己找"
    },
    {
      "t": 23.0,
      "text": "宁宁"
    },
    {
      "t": 25.0,
      "text": "妈让你受委屈了"
    },
    {
      "t": 28.0,
      "text": "不是你妈咱们走"
    },
    {
      "t": 33.0,
      "text": "别追了她不嫁我嫁"
    },
    {
      "t": 36.0,
      "text": "许晴当着这么多人你"
    },
    {
      "t": 39.0,
      "text": "他连婚都说不结就不结"
    },
    {
      "t": 41.0,
      "text": "我不会我什么都听你的"
    },
    {
      "t": 43.0,
      "text": "晴晴他刚才还要娶你姐姐"
    },
    {
      "t": 46.0,
      "text": "是他自己不要的"
    },
    {
      "t": 47.0,
      "text": "我为什么不能选周承"
    },
    {
      "t": 49.0,
      "text": "你刚才劝我把妈送走"
    },
    {
      "t": 50.0,
      "text": "是盼着我让位"
    }
  ]
}