  "lines": [
    {
      "t": 6,
      "text": "因为买不起一包卫生巾"
    },
    {
      "t": 8,
      "text": "我和丈夫提了离婚"
    },
    {
      "t": 10,
      "text": "姜菜庆"
    },
    {
      "t": 12,
      "text": "我来例假了"
    },
    {
      "t": 14,
      "text": "我月初不是才给了你2，800"
    },
    {
      "t": 16,
      "text": "给妈买的药花了800多"
    },
    {
      "t": 20,
      "text": "还有你让我买的东西"
    },
    {
      "t": 22,
      "text": "都是从里面出的"
    },
    {
      "t": 24,
      "text": "可我做销售"
    },
    {
      "t": 26,
      "text": "压力也大"
    },
    {
      "t": 30,
      "text": "我知道我就差10块多"
    },
    {
      "t": 32,
      "text": "要不你先看看"
    },
    {
      "t": 34,
      "text": "我这边客户还等着"
    },
    {
      "t": 36,
      "text": "等谈完单子再说吧"
    },
    {
      "t": 38,
      "text": "我提神用的"
    },
    {
      "t": 42,
      "text": "我给这个家当牛做马了4年"
    },
    {
      "t": 44,
      "text": "这次我不想再忍了"
    },
    {
      "t": 46,
      "text": "老板这两盒咖啡我不要了"
    },
    {
      "t": 48,
      "text": "好您稍等"
    },
    {
      "t": 52,
      "text": "英信"
    },
    {
      "t": 56,
      "text": "张律师我想预约咨询"
    }
  ]
