# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
build/
dist/
.pytest_cache/

# Data (media must never be committed)
data/
*.db
*.db-wal
*.db-shm

# Env / secrets
.env
config.local.json

# 运行中进度（脚本实时写，不必入库）
runs/进度/

# 进度网页服务的运行日志（autopilot 起服务时写，每次覆盖）
runs/.ui_server.log

# 交付用的预览/母版 mp4 放这里，媒体不入库（可再生）
delivery/*.mp4

# 版本监控的远端清单快照：从项目资产取到本机，各机器自己取、会过期
updates/

# WorkBuddy local state (memory / handoff) — never commit
.workbuddy/

# 素材抽帧缓存（可随时删，不占原片）
assets/**/frames/
assets/**/edge_frames/

# 按平台下下来的 ffmpeg / ffprobe（ffbin.py 放这儿，各机器自己下一次）
/bin/

# 修饰技能要用的四款中文字体（41MB，思源/OPPO 开源可商用）。
# 放共用层 assets/fonts/，一部机器放一次、所有剧共用；字体体积大不进库，
# 换机器从项目资产「字体/」拷一次。缺了技能会降级到系统字体并明说。
assets/fonts/

# 门禁回归测试产物（check_finale_gate.py；沙箱下可能删不掉，忽略即可）
*.gatecheck.json
build/.gatecheck/

# mix_trailer.py 自动生成的黑场底图（可再生缓存）
**/build_black_*.png

# 成片可由 plan + mix_trailer.py 再生，不进库（仓库历史上从未跟踪过 mp4）
runs/**/sd_*.mp4

# 媒体一律不入库：成片 / AI 片段都能由清单与提示词再生
runs/**/*.mp4
assets/ai_assets/shots/*.mp4
*.sqlite

# AI 出片临时校验截图（可随时重新抽帧生成）
assets/ai_assets/shots/_check_*.png
assets/ai_assets/shots/_check_*.jpg

# 文生图工具落盘的原图（提示词可复现，不进库）
generated-images/

# 标注实验（tools/）只入库脚本和结果表；抽帧、切片、试听音频、模型和虚拟环境都不入库
*_env/
tools/**/.venv/
tools/**/models/
tools/**/frames/
tools/**/doubt_frames/
tools/**/truth_frames/
tools/**/truth_audio/
tools/**/samples/
tools/**/待听辨音频/

# 标注工具的本机配置（含绝对路径，换机器只改它）；模板见 config.example.json
tools/speaker_label/config.json

# 注意：上面「成片可再生成、不进库」是给普通成片写的通用规则。
# 去重专题六轮迭代的报告与成片原件是「怎么一步步改对」的证据，不按可再生素材清理：
#   原件目录 runs/以真心守护至亲/D3_线一认不认这个妈/build/去重预览/（六处请勿删除标记）
#   入库副本 docs/去重专题素材/，完整清单与边界 docs/去重专题_素材总账.md
# 这里只加说明，不改上面任何一条忽略规则。
