# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
build/
dist/
.pytest_cache/

# Data (media must never be committed)
data/
*.db
*.db-wal
*.db-shm

# Web
web/node_modules/
web/dist/

# Env / secrets
.env
config.local.json

# WorkBuddy local state (memory / handoff) — never commit
.workbuddy/

# 素材抽帧缓存（可随时删，不占原片）
assets/**/frames/
assets/**/edge_frames/

# 门禁回归测试产物（check_finale_gate.py；沙箱下可能删不掉，忽略即可）
*.gatecheck.json
build/.gatecheck/

# mix_trailer.py 自动生成的黑场底图（可再生缓存）
**/build_black_*.png
