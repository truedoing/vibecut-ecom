# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
build/
dist/
.pytest_cache/

# Data (media must never be committed)
data/
*.db
*.db-wal
*.db-shm

# Env / secrets
.env
config.local.json

# 运行中进度（脚本实时写，不必入库）
runs/进度/

# WorkBuddy local state (memory / handoff) — never commit
.workbuddy/

# 素材抽帧缓存（可随时删，不占原片）
assets/**/frames/
assets/**/edge_frames/

# 门禁回归测试产物（check_finale_gate.py；沙箱下可能删不掉，忽略即可）
*.gatecheck.json
build/.gatecheck/

# mix_trailer.py 自动生成的黑场底图（可再生缓存）
**/build_black_*.png

# 成片可由 plan + mix_trailer.py 再生，不进库（仓库历史上从未跟踪过 mp4）
runs/**/sd_*.mp4

# 媒体一律不入库：成片 / AI 片段都能由清单与提示词再生
runs/**/*.mp4
assets/ai_assets/shots/*.mp4
*.sqlite

# AI 出片临时校验截图（可随时重新抽帧生成）
assets/ai_assets/shots/_check_*.png

# 注意：上面「成片可再生成、不进库」是给普通成片写的通用规则。
# 去重专题六轮迭代的报告与成片原件是「怎么一步步改对」的证据，不按可再生素材清理：
#   原件目录 runs/以真心守护至亲/D3_线一认不认这个妈/build/去重预览/（六处请勿删除标记）
#   入库副本 docs/去重专题素材/，完整清单与边界 docs/去重专题_素材总账.md
# 这里只加说明，不改上面任何一条忽略规则。
